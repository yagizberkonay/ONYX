{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Onyx",
  "version": "0.1.0",
  "identifier": "com.onyx.api",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Onyx",
        "url": "splash-screen.html",
        "width": 460,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "fullscreen": false
      },
      {
        "label": "main",
        "title": "Onyx",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["onyx"],
        "name": "Onyx Document",
        "description": "Onyx local API notebook and review document",
        "mimeType": "application/vnd.onyx.document",
        "role": "Editor"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
